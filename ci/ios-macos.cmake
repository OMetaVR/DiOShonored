# CMake toolchain: arm64 iOS on macOS with Xcode's clang and iPhoneOS SDK (used by ci/build_ios.sh and GitHub Actions).
set(CMAKE_SYSTEM_NAME iOS)
set(CMAKE_SYSTEM_PROCESSOR arm64)
set(CMAKE_OSX_ARCHITECTURES arm64)
if(NOT IOS_MIN)
  set(IOS_MIN "15.0")
endif()
set(CMAKE_OSX_DEPLOYMENT_TARGET "${IOS_MIN}")
execute_process(COMMAND xcrun --sdk iphoneos --show-sdk-path OUTPUT_VARIABLE IOS_SDK OUTPUT_STRIP_TRAILING_WHITESPACE)
set(CMAKE_OSX_SYSROOT "${IOS_SDK}")
set(DISH_XCODE_TOOLCHAIN ON)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES IOS_MIN)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE BOTH)
