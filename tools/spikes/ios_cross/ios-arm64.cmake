# CMake toolchain: arm64 iOS from Linux using clang + ld64.lld + an iPhoneOS SDK directory.
# Usage: cmake -DCMAKE_TOOLCHAIN_FILE=ios-arm64.cmake -DIOS_SDK=/path/to/iPhoneOS.sdk [-DIOS_MIN=15.0] ...
# IOS_SDK may be the theos iPhoneOS16.5.sdk (headers+tbd, enough to compile and link) or an SDK extracted by xtool.
if(NOT IOS_SDK)
  set(IOS_SDK "$ENV{IOS_SDK}")
endif()
if(NOT IOS_SDK)
  message(FATAL_ERROR "set IOS_SDK to an iPhoneOS.sdk directory")
endif()
# Linker: the SDK from Xcode 27 uses tbd arch names ("arm64e.x1") that distro lld 22 cannot parse; xtool ships a
# working LLD in <swift-sdk>/toolset/bin/orig/ld64.lld. build_rt_shim.sh symlinks $IOS_LD (default: ld64.lld on PATH)
# to out/ldbin/ld64.lld and we pass "-B out/ldbin -fuse-ld=lld" ( --ld-path makes clang emit ld64-classic args and fails ).
if(NOT IOS_LD)
  set(IOS_LD "$ENV{IOS_LD}")
endif()
if(NOT IOS_LD)
  set(IOS_LD "ld64.lld")
endif()
if(NOT IOS_MIN)
  set(IOS_MIN "15.0")
endif()
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES IOS_SDK IOS_MIN IOS_LD)
set(CMAKE_SYSTEM_NAME iOS)
set(CMAKE_SYSTEM_PROCESSOR arm64)
set(CMAKE_OSX_ARCHITECTURES arm64)
set(CMAKE_OSX_SYSROOT "${IOS_SDK}")
set(CMAKE_OSX_DEPLOYMENT_TARGET "${IOS_MIN}")
set(CMAKE_C_COMPILER clang)
set(CMAKE_CXX_COMPILER clang++)
set(CMAKE_OBJC_COMPILER clang)
set(CMAKE_OBJCXX_COMPILER clang++)
set(_flags "--target=arm64-apple-ios${IOS_MIN} -isysroot ${IOS_SDK} -mios-version-min=${IOS_MIN}")
set(CMAKE_C_FLAGS_INIT "${_flags}")
set(CMAKE_CXX_FLAGS_INIT "${_flags}")
set(CMAKE_OBJC_FLAGS_INIT "${_flags}")
set(CMAKE_OBJCXX_FLAGS_INIT "${_flags}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-B${CMAKE_CURRENT_LIST_DIR}/out/ldbin -fuse-ld=lld")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-B${CMAKE_CURRENT_LIST_DIR}/out/ldbin -fuse-ld=lld")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "-B${CMAKE_CURRENT_LIST_DIR}/out/ldbin -fuse-ld=lld")
set(CMAKE_AR llvm-ar CACHE FILEPATH "")
set(CMAKE_RANLIB llvm-ranlib CACHE FILEPATH "")
set(CMAKE_INSTALL_NAME_TOOL llvm-install-name-tool CACHE FILEPATH "")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

# Link the compiler-rt availability shim (see rt_shim/); build it first with build_rt_shim.sh.
set(_rtshim "${CMAKE_CURRENT_LIST_DIR}/out")
foreach(_k EXE SHARED MODULE)
  set(CMAKE_${_k}_LINKER_FLAGS_INIT "${CMAKE_${_k}_LINKER_FLAGS_INIT} -L${_rtshim} -lclang_rt_shim")
endforeach()
